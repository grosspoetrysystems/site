{
  "name": "@grosspoetrysystems/site",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm tokens && pnpm --filter pages build && vite build",
    "cf-typegen": "wrangler types",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm knip",
    "deploy": "pnpm build && env -u CF_API_TOKEN -u CF_ACCOUNT_ID wrangler deploy",
    "dev": "pnpm tokens && pnpm --filter pages build && vite dev",
    "fix": "pnpm tokens && ultracite fix",
    "knip": "knip",
    "lint": "pnpm tokens && ultracite check",
    "prepare": "lefthook install",
    "preview": "vite preview",
    "test": "vitest run",
    "tokens": "tz build",
    "typecheck": "pnpm tokens && tsc --noEmit && pnpm --filter pages exec astro sync && tsc --noEmit -p pages",
    "pages": "pnpm tokens && pnpm --filter pages dev"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-start": "^1.169.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@shadcn/lint": "^0.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@terrazzo/cli": "^2.9.0",
    "@terrazzo/plugin-css": "^2.9.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "knip": "^6.42.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.88.0",
    "shadcn": "^4.22.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "ultracite": "^8.0.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  }
}
