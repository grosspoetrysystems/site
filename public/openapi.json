{
  "openapi": "3.1.0",
  "info": {
    "title": "Gross Poetry Systems catalogue",
    "version": "1.0.0",
    "description": "Read-only description of the studio catalogue. No authentication; every response is public. Each product points at its own documentation corpus (llms.txt, Poolboy graph.json) at its own deploy target."
  },
  "servers": [
    {
      "url": "https://grosspoetry.systems"
    }
  ],
  "paths": {
    "/catalogue.json": {
      "get": {
        "operationId": "getCatalogue",
        "summary": "List released products and projects in the works",
        "responses": {
          "200": {
            "description": "The catalogue",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Catalogue"
                }
              }
            }
          }
        }
      }
    },
    "/llms.txt": {
      "get": {
        "operationId": "getLlmsTxt",
        "summary": "Plain-text index for language models, linking each project's own docs",
        "responses": {
          "200": {
            "description": "llms.txt",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Catalogue": {
        "type": "object",
        "required": ["name", "url", "products", "pending"],
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "products": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Product"
            }
          },
          "pending": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Pending"
            }
          }
        }
      },
      "Product": {
        "type": "object",
        "required": [
          "id",
          "url",
          "number",
          "name",
          "kind",
          "summary",
          "version",
          "license",
          "install",
          "links",
          "llms",
          "graph"
        ],
        "properties": {
          "id": {
            "type": "string",
            "examples": ["poolboy"]
          },
          "number": {
            "type": "string",
            "examples": ["GPS-0001"]
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "version": {
            "type": "string",
            "examples": ["v0.3.0"]
          },
          "license": {
            "type": "string",
            "description": "SPDX identifier"
          },
          "install": {
            "type": "string",
            "description": "Shell command"
          },
          "links": {
            "type": "object",
            "description": "Keyed by label, e.g. docs, source",
            "additionalProperties": {
              "type": "string",
              "format": "uri"
            }
          },
          "llms": {
            "type": ["string", "null"],
            "format": "uri",
            "description": "The project's own llms.txt"
          },
          "graph": {
            "type": ["string", "null"],
            "format": "uri",
            "description": "The project's Poolboy corpus manifest"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "The product page on grosspoetry.systems"
          }
        }
      },
      "Pending": {
        "type": "object",
        "required": ["id", "name", "kind", "summary", "source"],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "source": {
            "type": ["string", "null"],
            "format": "uri"
          }
        }
      }
    }
  }
}
