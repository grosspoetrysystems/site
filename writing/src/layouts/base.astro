---
import { PRODUCTS } from "../../../src/lib/catalogue";
import { PALETTE_STORAGE_KEY, PALETTES } from "../../../src/lib/palette";
import { NAME, shareMeta } from "../../../src/lib/share";
import "../styles/writing.css";

interface Props {
  title: string;
  description?: string;
  published?: Date;
}

const { title, description, published } = Astro.props;
const share = shareMeta({ title, description, path: Astro.url.pathname, published });
const restorePalette = `try{var p=localStorage.getItem(${JSON.stringify(PALETTE_STORAGE_KEY)});if(${JSON.stringify(PALETTES)}.indexOf(p)>-1)document.documentElement.dataset.palette=p}catch(e){}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{share.title}</title>
    {share.meta.map((m) => ("name" in m ? <meta name={m.name} content={m.content} /> : <meta property={m.property} content={m.content} />))}
    <link rel="canonical" href={share.url} />
    <link rel="alternate" type="application/rss+xml" title={`${NAME} · Writing`} href={`${import.meta.env.BASE_URL}rss.xml`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;800;900&family=Courier+Prime:wght@400;700&family=Newsreader:ital,opsz,wght@0,6..72,400;1,6..72,400&display=swap"
    />
    <script is:inline set:html={restorePalette} />
  </head>
  <body>
    <nav aria-label="Site">
      <ul>
        <li><a href="/">Gross Poetry Systems</a></li>
        {PRODUCTS.map((p) => <li><a href={`/${p.id}`}>{p.name}</a></li>)}
        <li>
          {Astro.url.pathname === import.meta.env.BASE_URL ? (
            <span aria-current="page">Writing</span>
          ) : (
            <a href={import.meta.env.BASE_URL}>Writing</a>
          )}
        </li>
        <li><a href={`${import.meta.env.BASE_URL}rss.xml`}>RSS</a></li>
      </ul>
    </nav>
    <main>
      <slot />
    </main>
  </body>
</html>
