---
import Base from "../layouts/base.astro";
import { isoDate, publishedPosts } from "../lib/posts";

const posts = await publishedPosts();
---

<Base title="Writing">
  <h1>Writing</h1>
  {
    posts.length === 0 ? (
      <p>Nothing published yet.</p>
    ) : (
      <ul>
        {posts.map((post) => (
          <li>
            <a href={`${import.meta.env.BASE_URL}${post.id}/`}>{post.data.title}</a>,{" "}
            <time datetime={isoDate(post.data.date)}>{isoDate(post.data.date)}</time>
          </li>
        ))}
      </ul>
    )
  }
</Base>
