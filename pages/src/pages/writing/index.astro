---
import Page from "../../layouts/page.astro";
import { LINK } from "../../lib/link";
import { isoDate, publishedPosts } from "../../lib/posts";

const posts = await publishedPosts();
---

<Page title="Writing" image="/og/writing.png">
  <h1 class="m-0 text-base font-bold">Writing</h1>
  {
    posts.length === 0 ? (
      <p class="mt-2">Nothing published yet.</p>
    ) : (
      <ul class="mt-2 list-disc pl-5">
        {posts.map((post) => (
          <li>
            <a class={LINK} href={`/writing/${post.id}/`}>
              {post.data.title}
            </a>
            , <time class="font-mono text-xs" datetime={isoDate(post.data.date)}>{isoDate(post.data.date)}</time>
          </li>
        ))}
      </ul>
    )
  }
  <p class="mt-4"><a class={LINK} href="/writing/rss.xml">RSS</a></p>
</Page>
