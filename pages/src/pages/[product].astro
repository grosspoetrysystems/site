---
import type { GetStaticPaths } from "astro";

import { PRODUCTS } from "../../../src/lib/catalogue";
import ExternalLink from "../components/external-link.astro";
import Page from "../layouts/page.astro";

export const getStaticPaths = (() =>
  PRODUCTS.map((p) => ({ params: { product: p.id }, props: { p } }))) satisfies GetStaticPaths;

const { p } = Astro.props;
---

<Page title={p.name} description={p.summary} image={`/og/${p.id}.png`}>
  <p class="label m-0">{p.number} · {p.kind}</p>
  <h1 class="mt-2 mb-0 text-base font-bold">{p.name}</h1>
  <p class="mt-2 mb-4">{p.summary}</p>
  <div class="divide-foreground border-foreground flex divide-x border">
    <code class="min-w-0 flex-1 px-2.5 py-2 font-mono text-sm wrap-anywhere">{p.install}</code>
    <button
      aria-label={`copy install command: ${p.install}`}
      class="label hover:bg-muted cursor-pointer px-3"
      data-copy={p.install}
      type="button">copy</button
    >
    <output class="sr-only"></output>
  </div>
  <ul class="mt-4 list-disc pl-5">
    <li>{p.version}</li>
    <li>{p.license}</li>
    {
      p.links.map((l) => (
        <li class="capitalize">
          <ExternalLink href={l.href}>{l.label}</ExternalLink>
        </li>
      ))
    }
    {
      p.llms && (
        <li>
          <ExternalLink href={p.llms}>llms.txt</ExternalLink>
        </li>
      )
    }
    {
      p.graph && (
        <li>
          <ExternalLink href={p.graph}>graph.json</ExternalLink>
        </li>
      )
    }
  </ul>
</Page>
